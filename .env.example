# Copia este archivo como .env (nunca subas .env al repositorio)
VITE_API_URL=https://odontosystem-production.up.railway.app
# Client ID OAuth de tipo Web (el mismo que GOOGLE_CLIENT_ID del backend).
# En Android el plugin lo usa como server client id. No pongas el cliente Android ni un client secret.
VITE_GOOGLE_CLIENT_ID=
# Notificaciones push: déjalo en false hasta tener android/app/google-services.json
VITE_PUSH_ENABLED=true
